{
  "schema_version": 2,
  "cases": [
    {
      "id": "literal-punctuation",
      "category": "positive_literal",
      "source": "Hello world",
      "candidate": "Hello, world!",
      "reference_judgment": "acceptable",
      "expected_status": "rewritten",
      "expected_reason": null,
      "expected_output": "candidate"
    },
    {
      "id": "literal-crlf",
      "category": "positive_literal",
      "source": "First line\r\nSecond line\r\n",
      "candidate": "First line.\r\nSecond line.\r\n",
      "reference_judgment": "acceptable",
      "expected_status": "rewritten",
      "expected_reason": null,
      "expected_output": "candidate"
    },
    {
      "id": "literal-unicode",
      "category": "positive_literal",
      "source": "Café déjà vu",
      "candidate": "Café, déjà vu.",
      "reference_judgment": "acceptable",
      "expected_status": "rewritten",
      "expected_reason": null,
      "expected_output": "candidate"
    },
    {
      "id": "same-content",
      "category": "identity",
      "source": "No change",
      "candidate": "No change",
      "reference_judgment": "identity",
      "expected_status": "unchanged_no_eligible_content",
      "expected_reason": null,
      "expected_output": "source"
    },
    {
      "id": "empty-source",
      "category": "identity",
      "source": "",
      "candidate": "ignored",
      "reference_judgment": "not_applicable",
      "expected_status": "unchanged_no_eligible_content",
      "expected_reason": null,
      "expected_output": "source"
    },
    {
      "id": "number-change",
      "category": "protected_value_negative",
      "source": "Version 2 costs $10.",
      "candidate": "Version 3 costs $10.",
      "reference_judgment": "unacceptable",
      "expected_status": "abstained",
      "expected_reason": "protected_value_changed",
      "expected_output": "source"
    },
    {
      "id": "url-change",
      "category": "protected_value_negative",
      "source": "Visit https://example.com now.",
