* text=auto
.gitattributes text eol=lf

*.md text eol=lf
*.mmd text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.sh text eol=lf
*.tsv text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
Cargo.lock text eol=lf

*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary

fixtures/** -text
fuzz/corpus/** -text

*.asc -text

*.patch text eol=lf whitespace=-blank-at-eol

# Preserve complete upstream legal text, including its original trailing spaces.
support/third-party-licenses/*.txt whitespace=-blank-at-eol
